generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String?  @unique
  phone     String?  @unique
  name      String?
  fullName  String?
  avatarUrl String?
  handle    String?  @unique
  role      String   @default("buyer")
  isSeller  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products       Product[]
  sellerOffers   SellerOffer[]
  orders         Order[]         @relation("UserOrders")
  buyerOrders    Order[]         @relation("BuyerOrders")
  vendorOrders   Order[]         @relation("VendorOrders")
  wallet         Wallet?
  notifications  Notification[]
  fileAssets     FileAsset[]
  vendorProfile  VendorProfile?
  cartItems      CartItem[]
}

model VendorProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  shopName    String
  location    String?
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  products     Product[]
  sellerOffers SellerOffer[]
  orders       Order[]
}

/// Amazon-style canonical catalog entry (one product identity, many seller offers).
/// Images are Storage URLs only — never binary blobs (keeps free Postgres small).
model MasterProduct {
  id               String   @id @default(uuid())
  /// Public catalog code e.g. PMIN-B08X9J4M12 (unique like ASIN)
  pmin             String   @unique
  barcode          String?  @unique
  title            String
  titleBn          String?
  brand            String   @default("Generic")
  category         String
  categoryId       String?
  description      String?
  /// Public image URLs from Supabase Storage (not DB blobs)
  canonicalImages  String[]
  /// Spec map e.g. { "color": "Black", "weight": "1kg" }
  specifications   Json?
  /// Variant axis e.g. [{ "name": "Size", "values": ["S","M","L"] }]
  variantOptions   Json?
  isVerified       Boolean  @default(false)
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  offers   SellerOffer[]
  products Product[]

  @@index([category])
  @@index([brand])
  @@index([title])
}

/// One seller's offer against a MasterProduct (price, stock, MOQ, wholesale tiers).
model SellerOffer {
  id               String   @id @default(uuid())
  masterProductId  String
  sellerId         String
  vendorId         String?
  /// Denormalized for fast lookup / Buy-Box (same as MasterProduct.pmin)
  pmin             String
  price            Float
  originalPrice    Float?
  stock            Int      @default(0)
  moq              Int      @default(1)
  /// retail | wholesale
  tradeMode        String   @default("retail")
  /// [{ "minQty": 50, "pricePerUnit": 800 }]
  wholesaleTiers   Json?
  /// Seller's own shelf/condition photos (Storage URLs)
  sellerPhotos     String[]
  deliveryEta      String?
  location         String?
  condition        String   @default("New")
  fulfillmentType  String   @default("seller_fulfilled")
  shippingFee      Float    @default(0)
  isBuyBoxWinner   Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  masterProduct MasterProduct  @relation(fields: [masterProductId], references: [id], onDelete: Restrict)
  seller        User           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  vendor        VendorProfile? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([masterProductId])
  @@index([sellerId])
  @@index([pmin])
  @@index([isActive, isBuyBoxWinner])
  @@unique([masterProductId, sellerId])
}

/// Legacy / direct listing (Phase-1 compatible). Optionally links to MasterProduct.
model Product {
  id              String   @id @default(uuid())
  title           String
  description     String
  price           Float
  originalPrice   Float?
  categoryId      String?
  category        String?
  sellerId        String?
  vendorId        String?
  stock           Int      @default(0)
  moq             Int      @default(1)
  images          String[]
  tieredPrices    Json?
  /// Optional link into master catalog (null = standalone legacy product)
  masterProductId String?
  pmin            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  seller        User?          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  vendor        VendorProfile? @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  masterProduct MasterProduct? @relation(fields: [masterProductId], references: [id], onDelete: SetNull)
  orderItems    OrderItem[]
  cartItems     CartItem[]

  @@index([masterProductId])
  @@index([pmin])
}

model Order {
  id               String    @id @default(uuid())
  orderNo          String?   @unique
  idempotencyKey   String?   @unique
  userId           String?
  buyerId          String?
  sellerId         String?
  vendorId         String?
  status           String    @default("pending")
  paymentStatus    String?   @default("pending")
  paymentMethod    String?   @default("cod")
  deliveryType     String?   @default("standard")
  scheduledSlot    DateTime?
  deliveryAddress  String?
  deliveryDistrict String?
  notes            String?
  total            Float     @default(0)
  subtotal         Float?    @default(0)
  shippingFee      Float?    @default(0)
  vatAmount        Float?    @default(0)
  totalAmount      Float?
  price            Float     @default(0)
  platformProfit   Float?    @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user       User?          @relation("UserOrders", fields: [userId], references: [id], onDelete: Cascade)
  buyer      User?          @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: SetNull)
  vendorUser User?          @relation("VendorOrders", fields: [sellerId], references: [id], onDelete: SetNull)
  vendor     VendorProfile? @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  orderItems OrderItem[]
  escrows    Escrow[]
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  productId    String?
  title        String?
  productTitle String?
  productImage String?
  unitPrice    Float?
  quantity     Int      @default(1)
  qty          Int      @default(1)
  price        Float
  createdAt    DateTime @default(now())

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model CartItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  qty       Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Escrow {
  id        String    @id @default(uuid())
  orderId   String
  amount    Float
  status    String    @default("held")
  releaseAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Notification {
  id             String   @id @default(uuid())
  userId         String
  title          String
  body           String
  type           String?
  actorAvatarUrl String?
  read           Boolean  @default(false)
  category       String?
  link           String?
  metadata       Json?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Wallet {
  id        String        @id @default(uuid())
  userId    String        @unique
  balance   Float         @default(0.0)
  coins     Int           @default(0)
  updatedAt DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

model Transaction {
  id             String   @id @default(uuid())
  walletId       String
  idempotencyKey String?  @unique
  title          String?
  subtitle       String?
  amount         Float
  type           String
  status         String   @default("completed")
  createdAt      DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
}

model FileAsset {
  id           String   @id @default(uuid())
  ownerId      String
  purpose      String   @default("general")
  bucket       String
  path         String
  url          String?
  isPrivate    Boolean  @default(false)
  mimeType     String
  size         Int
  originalName String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([purpose])
  @@index([bucket])
}
