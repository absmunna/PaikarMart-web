{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": ["node", "vite/client"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@shared/*": [
        "./src/shared/*"
      ],
      "@shared": [
        "./src/shared"
      ],
      "@modules/*": [
        "./src/modules/*"
      ],
      "@modules": [
        "./src/modules"
      ],
      "@lib/*": [
        "./src/lib/*"
      ],
      "@lib": [
        "./src/lib"
      ],
      "@ui/*": [
        "./src/components/ui/*"
      ],
      "@ui": [
        "./src/components/ui"
      ],
      "@portals/*": [
        "./src/portals/*"
      ],
      "@portals": [
        "./src/portals"
      ],
      "@components/*": [
        "./src/components/*"
      ],
      "@components": [
        "./src/components"
      ],
      "@backend/*": [
        "./backend/*"
      ],
      "@backend": [
        "./backend"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}
