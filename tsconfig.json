{
  "compilerOptions": {
    "target": "ES2022",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": ["node", "vite/client"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@modules/*": ["./src/modules/*"],
      "@portals/*": ["./src/portals/*"],
      "@shared/*": ["./src/shared/*"],
      "@ui/*": ["./src/components/ui/*"],
      "@app/*": ["./src/app/*"],
      "@lib/*": ["./src/lib/*"],
      "@backend/*": ["./backend/*"],
      "@pages/*": ["./src/pages/*"],
      "@workspace/api-client-react": ["./src/modules/app/api/client/index.ts"]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "noImplicitAny": false,
    "strict": false
  },
  "include": [
    "src",
    "backend",
    "vite.config.ts",
    "server.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
