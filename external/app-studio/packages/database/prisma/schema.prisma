// PaikarMart Master Database Schema (Supabase PostgreSQL + Prisma ORM)
// Synced 1:1 with supabase/schema.sql (Phases 1-6: Multi-Role RBAC, PII Isolation, PMIN 1:N, Hyperlocal Geofence, Logistics & Escrow)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  authUid      String    @unique @map("auth_uid")
  email        String    @unique
  phone        String?   @unique
  name         String
  handle       String    @unique
  avatarUrl    String?   @map("avatar_url")
  role         String    @default("consumer") // consumer | vendor | moderator | admin | super_admin
  activeRoles  String[]  @default(["consumer"]) @map("active_roles")
  trustLevel   Int       @default(1) @map("trust_level")
  location     String    @default("Dhaka, Bangladesh")
  balance      Decimal   @default(0.00) @db.Decimal(12, 2) @map("wallet_balance")
  rewardPoints Int       @default(0) @map("reward_points")
  isVerified   Boolean   @default(false) @map("is_verified")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  privateDetails     PrivateUserDetail?
  stores             Store[]
  listings           SellerListing[]
  catalogSubmissions CatalogSubmission[] @relation("SellerSubmissions")
  reviewedCatalogs   CatalogSubmission[] @relation("ReviewedSubmissions")
  reviews            ProductReview[]
  serviceOffers      ProviderServiceOffer[]
  orders             Order[]
  bookings           ServiceBooking[]
  socialPosts        SocialPost[]
  socialComments     SocialComment[]
  walletTransactions WalletTransaction[]
  escrowRecords      EscrowRecord[]

  @@map("profiles")
}

model PrivateUserDetail {
  id                  String   @id @default(uuid())
  profile             User     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId           String   @unique @map("profile_id")
  nidPassportNumber   String?  @map("nid_passport_number")
  emergencyPhone      String?  @map("emergency_phone")
  fullDeliveryAddress String?  @map("full_delivery_address")
  taxIdentificationNo String?  @map("tax_identification_no")
  payoutBankName      String?  @map("payout_bank_name")
  payoutAccountNo     String?  @map("payout_account_no")
  payoutRoutingNo     String?  @map("payout_routing_no")
  createdAt           DateTime @default(now()) @map("created_at")

  @@map("private_user_details")
}

model Store {
  id                String          @id @default(uuid())
  owner             User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId           String          @map("owner_id")
  handle            String          @unique
  storeName         String          @map("store_name")
  legalEntityName   String          @map("legal_entity_name")
  businessRegNo     String          @map("business_reg_no")
  taxId             String          @map("tax_id")
  sellerTier        String          @default("retail_seller") @map("seller_tier")
  kycStatus         String          @default("submitted") @map("kyc_status")
  category          String          // wholesale | retail | restaurant | services | rideshare | grocery
  isVerified        Boolean         @default(false) @map("is_verified")
  status            String          @default("pending") // active | pending | suspended
  commissionTier    String          @default("Standard 8%") @map("commission_tier")
  rating            Decimal         @default(5.00) @db.Decimal(3, 2)
  totalSales        Decimal         @default(0.00) @db.Decimal(12, 2) @map("total_sales")
  bannerUrl         String?         @map("banner_url")
  lat               Decimal?        @db.Decimal(9, 6)
  lng               Decimal?        @db.Decimal(9, 6)
  serviceRadiusKm   Decimal         @default(5.0) @db.Decimal(4, 1) @map("service_radius_km")
  isOpen            Boolean         @default(true) @map("is_open")
  openingHoursLabel String?         @default("9:00 AM - 9:00 PM") @map("opening_hours_label")
  prepMinutes       Int             @default(12) @map("prep_minutes")
  createdAt         DateTime        @default(now()) @map("created_at")

  // Relations
  listings          SellerListing[]
  products          Product[]

  @@map("stores")
}

model MasterProduct {
  id              String          @id @default(uuid())
  barcode         String?         @unique
  titleEn         String          @map("title_en")
  titleBn         String          @map("title_bn")
  brand           String          @default("Generic")
  category        String
  description     String?
  canonicalImages Json            @default("[]") @map("canonical_images")
  specifications  Json            @default("{}")
  isVerified      Boolean         @default(false) @map("is_verified")
  createdAt       DateTime        @default(now()) @map("created_at")

  // Relations
  sellerListings  SellerListing[]
  reviews         ProductReview[]

  @@map("master_products")
}

model SellerListing {
  id               String          @id @default(uuid())
  masterProduct    MasterProduct   @relation(fields: [masterProductId], references: [id], onDelete: Restrict)
  masterProductId  String          @map("master_product_id")
  store            Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId          String          @map("store_id")
  seller           User            @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId         String          @map("seller_id")
  price            Decimal         @db.Decimal(10, 2)
  originalPrice    Decimal?        @db.Decimal(10, 2) @map("original_price")
  stockQuantity    Int             @default(0) @map("stock_quantity")
  tradeMode        String          @default("retail") @map("trade_mode") // retail | wholesale
  minWholesaleQty  Int             @default(1) @map("min_wholesale_qty")
  wholesaleTiers   Json            @default("[]") @map("wholesale_tiers")
  sellerRealPhotos Json            @default("[]") @map("seller_real_photos")
  deliveryEta      String          @default("1-2 Days") @map("delivery_eta")
  location         String          @default("Dhaka, Bangladesh")
  isActive         Boolean         @default(true) @map("is_active")
  createdAt        DateTime        @default(now()) @map("created_at")

  reviews          ProductReview[]

  @@map("seller_listings")
}

model CatalogSubmission {
  id                  String   @id @default(uuid())
  seller              User     @relation("SellerSubmissions", fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId            String   @map("seller_id")
  proposedTitle       String   @map("proposed_title")
  proposedBrand       String?  @map("proposed_brand")
  proposedCategory    String   @map("proposed_category")
  proposedDescription String?  @map("proposed_description")
  proposedImages      Json     @default("[]") @map("proposed_images")
  proposedPrice       Decimal  @db.Decimal(10, 2) @map("proposed_price")
  tradeMode           String   @default("retail") @map("trade_mode")
  status              String   @default("pending_review") // pending_review | approved | rejected
  aiConfidenceScore   Decimal  @default(95.0) @db.Decimal(4, 1) @map("ai_confidence_score")
  aiAuditNotes        String?  @map("ai_audit_notes")
  reviewer            User?    @relation("ReviewedSubmissions", fields: [reviewedBy], references: [id])
  reviewedBy          String?  @map("reviewed_by")
  createdAt           DateTime @default(now()) @map("created_at")

  @@map("catalog_submissions")
}

model Product {
  id              String          @id @default(uuid())
  store           Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId         String          @map("store_id")
  type            String          // wholesale | retail | food | service | rides | grocery
  title           String
  description     String?
  price           Decimal         @db.Decimal(10, 2)
  originalPrice   Decimal?        @db.Decimal(10, 2) @map("original_price")
  minWholesaleQty Int             @default(1) @map("min_wholesale_qty")
  wholesaleTiers  Json            @default("[]") @map("wholesale_tiers")
  rating          Decimal         @default(5.00) @db.Decimal(3, 2)
  reviewsCount    Int             @default(0) @map("reviews_count")
  deliveryEta     String?         @map("delivery_eta")
  imageUrl        String          @map("image_url")
  category        String
  inStock         Boolean         @default(true) @map("in_stock")
  metadata        Json            @default("{}")
  createdAt       DateTime        @default(now()) @map("created_at")

  reviews         ProductReview[]
  socialPosts     SocialPost[]

  @@map("products")
}

model ProductReview {
  id                 String         @id @default(uuid())
  product            Product?       @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId          String?        @map("product_id")
  masterProduct      MasterProduct? @relation(fields: [masterProductId], references: [id], onDelete: Cascade)
  masterProductId    String?        @map("master_product_id")
  sellerListing      SellerListing? @relation(fields: [sellerListingId], references: [id], onDelete: Cascade)
  sellerListingId    String?        @map("seller_listing_id")
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String         @map("user_id")
  rating             Int
  comment            String
  reviewPhotos       Json           @default("[]") @map("review_photos")
  isVerifiedPurchase Boolean        @default(true) @map("is_verified_purchase")
  sellerReply        String?        @map("seller_reply")
  createdAt          DateTime       @default(now()) @map("created_at")

  @@map("product_reviews")
}

model MasterService {
  id                 String                 @id @default(uuid())
  titleEn            String                 @map("title_en")
  titleBn            String                 @map("title_bn")
  serviceType        String                 @map("service_type")
  description        String?
  includedChecklist  Json                   @default("[]") @map("included_checklist")
  estimatedDuration  String                 @default("60 Minutes") @map("estimated_duration")
  canonicalImageUrl  String?                @map("canonical_image_url")
  createdAt          DateTime               @default(now()) @map("created_at")

  providerOffers     ProviderServiceOffer[]

  @@map("master_services")
}

model ProviderServiceOffer {
  id              String        @id @default(uuid())
  masterService   MasterService @relation(fields: [masterServiceId], references: [id], onDelete: Cascade)
  masterServiceId String        @map("master_service_id")
  provider        User          @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerId      String        @map("provider_id")
  providerName    String        @map("provider_name")
  baseRate        Decimal       @db.Decimal(10, 2) @map("base_rate")
  serviceRadiusKm Decimal       @default(5.0) @db.Decimal(4, 1) @map("service_radius_km")
  verifiedBadge   Boolean       @default(false) @map("verified_badge")
  rating          Decimal       @default(5.00) @db.Decimal(3, 2)
  reviewsCount    Int           @default(0) @map("reviews_count")
  lat             Decimal?      @db.Decimal(9, 6)
  lng             Decimal?      @db.Decimal(9, 6)
  isOpen          Boolean       @default(true) @map("is_open")
  createdAt       DateTime      @default(now()) @map("created_at")

  @@map("provider_service_offers")
}

model SocialPost {
  id              String          @id @default(uuid())
  author          User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId        String          @map("author_id")
  content         String
  mediaUrl        String?         @map("media_url")
  taggedProduct   Product?        @relation(fields: [taggedProductId], references: [id], onDelete: SetNull)
  taggedProductId String?         @map("tagged_product_id")
  likesCount      Int             @default(0) @map("likes_count")
  sharesCount     Int             @default(0) @map("shares_count")
  isSponsored     Boolean         @default(false) @map("is_sponsored")
  adNetwork       String?         @map("ad_network")
  createdAt       DateTime        @default(now()) @map("created_at")

  comments        SocialComment[]

  @@map("social_posts")
}

model SocialComment {
  id          String     @id @default(uuid())
  post        SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId      String     @map("post_id")
  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId    String     @map("author_id")
  commentText String     @map("comment_text")
  createdAt   DateTime   @default(now()) @map("created_at")

  @@map("social_comments")
}

model Order {
  id              String            @id @default(uuid())
  idempotencyKey  String?           @unique @map("idempotency_key")
  buyer           User              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId      String            @map("customer_id")
  subtotal        Decimal           @db.Decimal(10, 2)
  deliveryFee     Decimal           @default(0.00) @db.Decimal(10, 2) @map("delivery_fee")
  tax             Decimal           @default(0.00) @db.Decimal(10, 2)
  total           Decimal           @db.Decimal(10, 2)
  status          String            @default("confirmed") // confirmed | preparing | in_transit | delivered | cancelled
  deliveryAddress String            @map("delivery_address")
  paymentMethod   String            @map("payment_method")
  items           Json
  buyerName       String?           @map("buyer_name")
  buyerPhone      String?           @map("buyer_phone")
  createdAt       DateTime          @default(now()) @map("created_at")

  shipment        ShipmentWaybill?
  escrow          EscrowRecord?

  @@map("orders")
}

model ShipmentWaybill {
  id             String         @id @default(uuid())
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId        String         @unique @map("order_id")
  trackingNumber String         @unique @map("tracking_number")
  courierPartner String         @default("PaikarForce") @map("courier_partner") // PaikarForce | Steadfast | Pathao | RedX
  status         String         @default("PENDING")
  deliveryOtp    String         @map("delivery_otp")
  pickupLocation String         @map("pickup_location")
  dropLocation   String         @map("drop_location")
  shippingFeeBdt Decimal        @default(60.00) @db.Decimal(10, 2) @map("shipping_fee_bdt")
  podVerifiedAt  DateTime?      @map("pod_verified_at")
  checkpoints    Json           @default("[]")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  returns        ReturnPickup[]

  @@map("shipment_waybills")
}

model ReturnPickup {
  id             String          @id @default(uuid())
  shipment       ShipmentWaybill @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  shipmentId     String          @map("shipment_id")
  returnWaybill  String          @unique @map("return_waybill")
  userId         String          @map("user_id")
  reason         String
  pickupAddress  String          @map("pickup_address")
  courierPartner String          @default("PaikarForce") @map("courier_partner")
  status         String          @default("PICKUP_SCHEDULED")
  createdAt      DateTime        @default(now()) @map("created_at")

  @@map("return_pickups")
}

model WalletTransaction {
  id          String   @id @default(uuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String   @map("user_id")
  type        String   // deposit | withdrawal | transfer | purchase | cashback | escrow_hold | escrow_release
  amount      Decimal  @db.Decimal(12, 2)
  description String
  status      String   @default("completed")
  referenceId String?  @map("reference_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("wallet_transactions")
}

model EscrowRecord {
  id         String    @id @default(uuid())
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String    @unique @map("order_id")
  buyer      User      @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  buyerId    String    @map("buyer_id")
  vendorId   String    @map("vendor_id")
  amountBdt  Decimal   @db.Decimal(12, 2) @map("amount_bdt")
  status     String    @default("held") // held | released | refunded | disputed
  releasedAt DateTime? @map("released_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("escrow_records")
}

model ServiceBooking {
  id              String   @id @default(uuid())
  customer        User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId      String   @map("customer_id")
  serviceId       String   @map("service_id")
  serviceTitle    String   @map("service_title")
  providerName    String   @map("provider_name")
  serviceAddress  String   @map("service_address")
  scheduledDate   String   @map("scheduled_date")
  timeSlot        String   @map("time_slot")
  status          String   @default("scheduled") // scheduled | in_progress | completed | cancelled
  depositAmount   Decimal  @default(0.00) @db.Decimal(10, 2) @map("deposit_amount")
  totalEstimate   Decimal  @db.Decimal(10, 2) @map("total_estimate")
  walletDiscount  Boolean  @default(false) @map("wallet_discount")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("service_bookings")
}

model RetailVoucher {
  id               String   @id @default(uuid())
  code             String   @unique
  titleEn          String   @map("title_en")
  titleBn          String   @map("title_bn")
  discountType     String   @map("discount_type") // percent | flat | free_shipping
  discountValue    Decimal  @default(0.00) @db.Decimal(10, 2) @map("discount_value")
  maxDiscountBdt   Decimal? @db.Decimal(10, 2) @map("max_discount_bdt")
  minSpendBdt      Decimal  @default(0.00) @db.Decimal(10, 2) @map("min_spend_bdt")
  eligibleCategory String?  @map("eligible_category")
  expiresAt        DateTime @map("expires_at")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("retail_vouchers")
}

model ProductQuestion {
  id         String    @id @default(uuid())
  productId  String    @map("product_id")
  authorId   String    @map("author_id")
  authorName String    @map("author_name")
  question   String
  answer     String?
  answeredBy String?   @map("answered_by")
  answeredAt DateTime? @map("answered_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("product_questions")
}

model PrescriptionUpload {
  id              String   @id @default(uuid())
  referenceCode   String   @unique @map("reference_code")
  orderIdRef      String   @map("order_id_ref")
  orderType       String   @default("pharmacy_rx") @map("order_type") // pharmacy_rx | grocery_list
  customerId      String   @map("customer_id")
  contactPhone    String   @map("contact_phone")
  deliveryAddress String   @map("delivery_address")
  notes           String?
  fileName        String?  @map("file_name")
  mimeType        String?  @map("mime_type")
  status          String   @default("submitted") // submitted | pharmacist_review | quoted | dispatched
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("prescription_uploads")
}

