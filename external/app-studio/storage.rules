rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/{folder}/{fileName} {
      allow read: if folder == 'avatars' || folder == 'videos' || isOwner(userId);

      allow create, update: if isOwner(userId) && (
        (folder == 'avatars' && request.resource.size < 5 * 1024 * 1024 &&
          request.resource.contentType.matches('image/(jpeg|png|webp)')) ||
        (folder == 'documents' && request.resource.size < 15 * 1024 * 1024 &&
          request.resource.contentType.matches('(application/pdf|image/(jpeg|png|webp))')) ||
        (folder == 'videos' && request.resource.size < 100 * 1024 * 1024 &&
          request.resource.contentType.matches('video/(mp4|webm)'))
      );

      allow delete: if isOwner(userId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
