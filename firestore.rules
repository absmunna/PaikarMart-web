rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default-deny catch-all (Global Safety Net)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'abs.munna1@gmail.com'
      );
    }

    // Entity Validation: UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'name', 'role']) &&
             data.keys().hasOnly(['uid', 'email', 'name', 'phone', 'role', 'avatarUrl', 'createdAt', 'updatedAt']) &&
             data.uid is string && data.uid == request.auth.uid &&
             data.email is string && data.email.size() > 3 && data.email.size() <= 256 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
             data.role in ['buyer', 'seller', 'wholesale_seller', 'service_provider', 'nearby_shop', 'rider', 'delivery_agent', 'admin'] &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 20)) &&
             (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 1000));
    }

    // Entity Validation: Order
    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'userId', 'totalAmount', 'status']) &&
             data.keys().hasOnly(['id', 'userId', 'totalAmount', 'status', 'deliveryAddress', 'createdAt']) &&
             data.id is string && isValidId(data.id) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.status in ['pending', 'confirmed', 'processing', 'shipped', 'delivered', 'cancelled'] &&
             (!('deliveryAddress' in data) || (data.deliveryAddress is string && data.deliveryAddress.size() <= 500));
    }

    // Users Collection (PII Isolated & ABAC Protected)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isValidId(userId) && (
        isAdmin() ||
        (isOwner(userId) && isValidUserProfile(incoming()) && incoming().uid == existing().uid)
      );
      allow delete: if isAdmin();
    }

    // Orders Collection
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isValidId(orderId) && isSignedIn() && isValidOrder(incoming());
      allow update: if isValidId(orderId) && (
        isAdmin() ||
        (isSignedIn() && existing().userId == request.auth.uid && isValidOrder(incoming()) && incoming().userId == existing().userId)
      );
      allow delete: if isAdmin();
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
