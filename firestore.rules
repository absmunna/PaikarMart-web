rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // -------------------------------------------------------------------------
    // 1. GLOBAL HELPERS & HARDENING
    // -------------------------------------------------------------------------
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // 2. CORE COLLECTIONS
    // -------------------------------------------------------------------------

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId);
    }

    // Products Collection
    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (existing().sellerId == request.auth.uid);
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read: if isSignedIn() && (existing().userId == request.auth.uid || existing().sellerId == request.auth.uid);
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && (existing().userId == request.auth.uid || existing().sellerId == request.auth.uid);
    }

    // Demands Collection
    match /demands/{demandId} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().authorUserId == request.auth.uid;
      allow update, delete: if isSignedIn() && existing().authorUserId == request.auth.uid;
    }

    // Notifications Collection (Real-time Bus)
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if false; // Only Backend should create notifications via Admin SDK
      allow update: if isSignedIn() && existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Chats & Messages
    match /chats/{chatId} {
      allow list: if isSignedIn() && resource.data.participants.hasAny([request.auth.uid]);
      allow get: if isSignedIn() && (request.auth.uid in existing().participants);
      allow create: if isSignedIn() && (request.auth.uid in incoming().participants);
      allow update: if isSignedIn() && (request.auth.uid in existing().participants);

      match /messages/{messageId} {
        allow read: if isSignedIn() && (get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]));
        allow create: if isSignedIn() && incoming().senderId == request.auth.uid;
        allow delete: if isSignedIn() && existing().senderId == request.auth.uid;
      }
    }

    // Posts Collection
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().authorId == request.auth.uid;
      allow update, delete: if isSignedIn() && existing().authorId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && incoming().authorId == request.auth.uid;
        allow update, delete: if isSignedIn() && existing().authorId == request.auth.uid;
      }

      match /likes/{userId} {
        allow read: if true;
        allow create, delete: if isOwner(userId);
      }
    }
  }
}

