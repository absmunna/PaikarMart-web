{
  "name": "@figma/my-make-file",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "prisma generate && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "lint": "tsc --noEmit && npm run audit",
    "audit": "echo 'Architecture Audit: Checking module boundaries...' && npm run audit:structure",
    "audit:structure": "ls -d src/modules/*/index.ts",
    "start": "node dist/server.cjs"
  },
