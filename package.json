{
  "name": "paikarmart-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@paikarmart/backend",
    "build": "npm run build --workspaces",
    "start": "npm run start --workspace=@paikarmart/backend",
    "postinstall": "cd packages/database && npx prisma generate",
    "typecheck": "npm run lint --workspace=@paikarmart/frontend",
    "lint": "npm run lint --workspace=@paikarmart/frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "~5.8.2"
  }
}
