{
  "name": "@paikarmart/backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node --no-deprecation dist/server.js",
    "build": "npx esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.js",
    "db:migrate:deploy": "prisma migrate deploy --schema=../../packages/database/prisma/schema.prisma",
    "typecheck": "tsc --noEmit",
    "test:security": "tsx tests/auth.security.test.ts",
    "test:wallet": "tsx tests/wallet.security.test.ts",
    "test:payment": "tsx tests/payment.security.test.ts",
    "test:order": "tsx tests/order.security.test.ts",
    "test:socket": "tsx tests/socket.security.test.ts"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "pg": "^8.20.0",
    "socket.io": "^4.8.3",
    "vite": "^6.2.3",
    "ws": "^8.21.3",
    "xss": "^1.0.15",
    "esbuild": "^0.25.0",
    "firebase-admin": "^12.0.0",
    "@supabase/supabase-js": "^2.49.1",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.14.0",
    "prisma": "^5.22.0",
    "tsx": "^4.22.0",
    "typescript": "~5.8.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
