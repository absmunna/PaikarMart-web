# ==============================================================================
# PAIKAR MART - BACKEND ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Set these variables in Render Dashboard -> Environment:

NODE_ENV=production
PORT=10000

# Supabase PostgreSQL Connection String (Prisma ORM)
# Use Transaction Mode Pooler on Render:
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct URL for Prisma migrations (npx prisma db push):
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# JWT Authentication Secret (32+ chars)
JWT_SECRET="replace_with_a_secure_random_jwt_secret_key_at_least_32_chars"
JWT_EXPIRES_IN="7d"

# Allowed CORS origins in production (comma-separated list of exact allowed origins, no wildcards in prod)
# Example: "https://paikarmart.vercel.app,https://paikarmart.com,https://www.paikarmart.com"
CLIENT_URL="https://your-paikarmart-app.vercel.app"
CORS_ORIGINS="https://your-paikarmart-app.vercel.app,https://paikarmart.com,https://www.paikarmart.com"

# Optional: Server-side AI features
GEMINI_API_KEY=""

# Firebase Admin SDK Credentials (Required for Secure Auth)
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
