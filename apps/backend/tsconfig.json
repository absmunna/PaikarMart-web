{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["../frontend/src/*"],
      "@/config/*": ["../frontend/src/core/config/*"],
      "@/core/*": ["../frontend/src/core/*"],
      "@backend/*": ["./*"],
      "shared/*": ["../../packages/shared/*"]
    }
  },
  "include": ["**/*.ts"]
}
