{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": false,
    "noEmit": true
  },
  "include": [
    "server.ts",
    "config/**/*.ts",
    "middleware/**/*.ts",
    "services/**/*.ts",
    "modules/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
