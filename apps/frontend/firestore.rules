rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isNotAnonymous() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Users: create as buyer only; cannot self-elevate role/roles/permissions
    match /users/{userId} {
      allow read: if isSignedIn();

      allow create: if isOwner(userId)
        && request.resource.data.role == 'buyer'
        && (!('roles' in request.resource.data)
            || request.resource.data.roles == ['buyer']);

      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['role', 'roles', 'permissions']);

      allow delete: if false;
    }

    // Products: public read; write only own sellerId docs
    match /products/{productId} {
      allow read: if true;
      allow create: if isNotAnonymous()
        && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if isNotAnonymous()
        && resource.data.sellerId == request.auth.uid
        && (!('sellerId' in request.resource.data)
            || request.resource.data.sellerId == request.auth.uid);
    }

    // Orders: buyer or seller party only
    match /orders/{orderId} {
      allow read: if isSignedIn()
        && (resource.data.buyerId == request.auth.uid
            || resource.data.sellerId == request.auth.uid
            || resource.data.userId == request.auth.uid);
      allow create: if isNotAnonymous()
        && (request.resource.data.buyerId == request.auth.uid
            || request.resource.data.userId == request.auth.uid);
      allow update: if isSignedIn()
        && (resource.data.buyerId == request.auth.uid
            || resource.data.sellerId == request.auth.uid);
      allow delete: if false;
    }

    // Wallet: owner only
    match /wallets/{userId} {
      allow read, write: if isOwner(userId);
    }
    match /transactions/{txId} {
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if isNotAnonymous()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
