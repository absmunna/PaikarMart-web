rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default-deny catch-all (Global Safety Net)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'abs.munna1@gmail.com'
      );
    }

    // Users Collection (PII Isolated & ABAC Protected)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isOwner(userId);
      allow update: if isValidId(userId) && (isAdmin() || isOwner(userId));
      allow delete: if isAdmin();
    }

    // Orders Collection
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isValidId(orderId) && isSignedIn();
      allow update: if isValidId(orderId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow delete: if isAdmin();
    }

    // Chats Collection & Messages Subcollection
    match /chats/{chatId} {
      allow get: if isValidId(chatId) && (isAdmin() || (isSignedIn() && request.auth.uid in existing().participants));
      allow list: if isSignedIn() && (isAdmin() || request.auth.uid in resource.data.participants);
      allow create: if isValidId(chatId) && isSignedIn() && request.auth.uid in incoming().participants;
      allow update: if isValidId(chatId) && isSignedIn() && (isAdmin() || request.auth.uid in existing().participants);
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow get, list: if isSignedIn();
        allow create: if isValidId(messageId) && isSignedIn();
        allow update, delete: if isAdmin();
      }
    }

    // Products Collection (Public Read Catalog)
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Categories Collection (Public Read)
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Demands Collection (Public Read)
    match /demands/{demandId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Posts Collection (Public Read Feed)
    match /posts/{postId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Sellers Collection
    match /sellers/{sellerId} {
      allow read: if true;
      allow create, update: if isSignedIn() && (isAdmin() || request.auth.uid == sellerId);
      allow delete: if isAdmin();
    }

    // Wallets Collection
    match /wallets/{userId} {
      allow read, write: if isSignedIn() && (isAdmin() || request.auth.uid == userId);

      match /transactions/{transactionId} {
        allow read, write: if isSignedIn() && (isAdmin() || request.auth.uid == userId);
      }
    }

    // Client Vault Files
    match /client_vault_files/{fileId} {
      allow read, write: if isSignedIn();
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
