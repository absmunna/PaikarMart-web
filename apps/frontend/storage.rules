rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }
    function isNotAnonymous() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function isOwnerPath(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Public product images — read anyone; write authenticated non-anonymous under own prefix
    match /products/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isNotAnonymous() && isOwnerPath(userId)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isNotAnonymous() && isOwnerPath(userId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /documents/{userId}/{allPaths=**} {
      allow read: if isOwnerPath(userId);
      allow write: if isNotAnonymous() && isOwnerPath(userId)
        && request.resource.size < 15 * 1024 * 1024;
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
