# ==============================================================================
# PAIKAR MART - ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# DO NOT COMMIT THE ACTUAL `.env` FILE TO GITHUB OR ANY PUBLIC REPOSITORY.
# Copy this file to `.env` locally or set these environment variables in your 
# hosting provider (e.g., Railway, Vercel, Supabase, Render, Docker).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL / Supabase / Railway)
# ------------------------------------------------------------------------------
# Standard PostgreSQL connection string used by Prisma ORM
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/paikarmart?schema=public"

# Direct URL for Prisma migrations when using Supabase transaction pooler (port 5432)
# DIRECT_URL="postgresql://postgres:your_password@db.your-supabase-id.supabase.co:5432/postgres"

# Optional Redis connection for session/caching
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION (JWT)
# ------------------------------------------------------------------------------
# Generate a strong 32+ character random secret for production JWT signing
JWT_SECRET="replace_with_a_secure_random_jwt_secret_key_at_least_32_chars"
JWT_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# 4. FRONTEND CONFIGURATION (Vite Client-Side: Must start with VITE_)
# ------------------------------------------------------------------------------
# In development, points to the local backend proxy (/api/v1) or full URL
# In production on Vercel/Railway, point to your deployed backend URL
VITE_API_BASE_URL="http://localhost:3000/api/v1"

# Supabase Client Configuration
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# ------------------------------------------------------------------------------
# 5. AI SERVICES (Google Gemini API - Server-side only)
# ------------------------------------------------------------------------------
# Configured securely on backend server-side proxy
GEMINI_API_KEY="your_gemini_api_key_here"

# ------------------------------------------------------------------------------
# 6. BANGLADESH PAYMENT GATEWAYS (Optional / Production Gateway Credentials)
# ------------------------------------------------------------------------------
# bKash Checkout URL API credentials
BKASH_APP_KEY="your_bkash_app_key"
BKASH_APP_SECRET="your_bkash_app_secret"
BKASH_USERNAME="your_bkash_username"
BKASH_PASSWORD="your_bkash_password"
BKASH_IS_SANDBOX=true

# Nagad API credentials
NAGAD_MERCHANT_ID="your_nagad_merchant_id"
NAGAD_PUBLIC_KEY="your_nagad_public_key"
NAGAD_PRIVATE_KEY="your_nagad_private_key"
NAGAD_IS_SANDBOX=true
