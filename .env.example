# ==============================================================================
# PAIKAR MART MONOREPO - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# ⚠️ SECURITY NOTICE:
# DO NOT COMMIT THE ACTUAL `.env` FILE TO GITHUB OR ANY PUBLIC REPOSITORY.
# This file is a template. Set these variables in:
# - Supabase: Project Settings -> Database -> Connection string
# - Render: Dashboard -> Service Settings -> Environment Variables
# - Vercel: Project Settings -> Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
# In Supabase: Project Settings -> Database -> Connection string -> URI
# Connection Pooler (Port 6543) - Recommended for Render & Serverless
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct URL for schema migrations & prisma db push (direct host port 5432)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase Client Public URL (frontend/client JS)
VITE_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key-here"

# ------------------------------------------------------------------------------
# 2. BACKEND API (Render / Production)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=10000

# High-entropy secret for signing JWT auth tokens (at least 32 characters)
JWT_SECRET="replace_with_a_secure_random_jwt_secret_key_at_least_32_chars"
JWT_EXPIRES_IN="7d"

# Allowed CORS origins in production (comma-separated list of exact allowed origins, no wildcards in prod)
# Example: "https://paikarmart.vercel.app,https://paikarmart.com,https://www.paikarmart.com"
CLIENT_URL="https://your-paikarmart-app.vercel.app"
CORS_ORIGINS="https://your-paikarmart-app.vercel.app,https://paikarmart.com,https://www.paikarmart.com"

# Optional: Google Gemini API Key for server-side AI search / demand matching
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 3. FRONTEND (Vercel)
# ------------------------------------------------------------------------------
# Set this in Vercel to point to your deployed Render backend:
VITE_API_BASE_URL="https://your-paikarmart-backend.onrender.com/api/v1"

# ------------------------------------------------------------------------------
# 4. FIREBASE ADMIN SDK (Backend Authentication)
# ------------------------------------------------------------------------------
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
